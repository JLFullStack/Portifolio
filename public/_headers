# Cabeçalhos HTTP dos arquivos estáticos (Cloudflare Workers Static Assets).

# A CSP é a mesma do Worker (worker/index.js): tudo da própria origem; connect-src 'self'
# impede que um script injetado envie dados a outro endereço.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# O link de convite leva o token na URL: nada dele vai no Referer.
/convite
  Referrer-Policy: no-referrer

# JS, CSS e fontes do Next têm o hash do conteúdo no nome: podem ficar em cache para sempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens exportadas do D1 (scripts/exportar-conteudo.mjs): o nome é o hash do conteúdo.
/midia/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos da semente (desenvolvimento sem banco): mudam raramente, mas sem hash no nome.
/imagens/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
