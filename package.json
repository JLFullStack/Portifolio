{
  "name": "portifolio",
  "private": true,
  "description": "Portfólio de Lucas Araújo: Next.js (exportação estática) publicado no Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "tipos": "tsc --noEmit",
