{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File", // especifica que o log será escrito em um arquivo
        "Args": {
          "path": "Logs/Desenvolvimento/log-.txt", // caminho do arquivo de log
          "rollingInterval": "Day", // cria um novo arquivo de log a cada dia
          "retainedFileCountLimit": 120, // teto de disco; a retenção real é dada por retainedFileTimeLimit
          "retainedFileTimeLimit": "30.00:00:00", // mantém 30 dias, independente de quantos arquivos o dia gerar
          "rollOnFileSizeLimit": true, // ao atingir o limite de tamanho, cria novo arquivo em vez de parar de gravar
          "fileSizeLimitBytes": 52428800, // 50 MB por arquivo, no lugar do padrão de 1 GB
          "shared": true, // permite que múltiplas instâncias escrevam no mesmo arquivo
          "outputTemplate": "\n\n{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}]\n\nMessage: {Message:l}\n\n{Exception}\n\n══════════════════════════════════════════════════════════════\n\n"
        }
      }
    ]
  }
}
