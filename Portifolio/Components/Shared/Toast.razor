<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="ntf-card" class="toast fade bg-solid-white" role="alert" aria-live="assertive" aria-atomic="true" data-bs-animation="true" data-bs-autohide="true" data-bs-delay="3000">

        <div class="toast-header text-white @(string.IsNullOrEmpty(msg_sucesso) ? "bg-danger" : "bg-primary")">
            <strong class="me-auto">NOVA MENSAGEM</strong>
        </div>

        <div class="toast-body py-4">
            <strong id="successMessage">@msg_sucesso</strong>
            <strong id="errorMessage">@msg_erro</strong>
        </div>

    </div>
</div>

@code {
    string msg_sucesso = "";
    string msg_erro = "";
}
