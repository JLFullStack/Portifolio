<!DOCTYPE html>
@* O idioma do documento acompanha a cultura da requisição, definida por
   UseRequestLocalization a partir do cookie gravado em /idioma. *@
<html lang="@CultureInfo.CurrentUICulture.Name.ToLowerInvariant()">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* Tema: aplica o data-tema ANTES da primeira pintura, senão o visitante que
       escolheu o tema claro vê o escuro piscar a cada carregamento.
       Precisa ser inline e vir antes das folhas de estilo. Padrão: escuro. *@
    <script>
        (function () {
            var tema = "escuro";
            try {
                if (localStorage.getItem("portifolio-tema") === "claro") tema = "claro";
            } catch (e) { /* localStorage bloqueado: segue no tema padrão */ }
            document.documentElement.setAttribute("data-tema", tema);
        })();
    </script>

    @* Bibliotecas de terceiros. Atenção à ordem: a cascata do projeto depende dela. *@
    <link rel="stylesheet" href="vendor/font-awesome-pro/pro-5.13.0/css/all.min.css" />
    <link rel="stylesheet" href="vendor/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="vendor/bootstrap-icons/font/bootstrap-icons.min.css" />

    @* Fontes locais. Inter é declarada em app.css; estas duas já trazem o próprio @@font-face. *@
    <link rel="stylesheet" href="assets/font/arimo/stylesheet.css" />
    <link rel="stylesheet" href="assets/font/ernestone/stylesheet.css" />

    @* Estilos do projeto. *@
    <link rel="stylesheet" href="assets/css/app.css" />
    <link rel="stylesheet" href="assets/css/animacao.css" />
    <link rel="stylesheet" href="assets/css/responsivo.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/biblioteca.js"></script>
    <script src="assets/js/app.js"></script>
</body>

</html>
